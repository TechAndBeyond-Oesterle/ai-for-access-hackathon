# AI for Access — Discord Setup
# Kopiere diese Datei zu .env und fülle die Werte. .env ist gitignored — NIE committen.

# Bot-Token aus dem Discord Developer Portal (Application → Bot → Reset Token)
DISCORD_TOKEN=

# Server-ID (Rechtsklick auf den Server → "Server-ID kopieren";
# Entwicklermodus muss in Discord-Einstellungen → Erweitert aktiv sein)
GUILD_ID=

# Application/Client-ID (Developer Portal → General Information → Application ID)
# Für den /team-Bot (Command-Registrierung). Nicht geheim.
CLIENT_ID=1531558085649367050
