# Airtable — personal access token with data.records:write on base appapD55EOTAiqT0I
AIRTABLE_PAT=

# Resend — API key from https://resend.com/api-keys
RESEND_API_KEY=

# From address for confirmation emails. Domain must be verified in Resend.
RESEND_FROM=AI for Access Hackathon <info@hackathon.powercoders.org>

# Resend audience for the "infos about next events" opt-in. Leave empty to skip.
RESEND_AUDIENCE_ID=
# Optional: key with contacts.write (the send-only key above cannot add contacts).
RESEND_CONTACTS_API_KEY=

# Poll tool (HCK-30). Both are optional, the code falls back to the values below.
AIRTABLE_BASE_ID=appapD55EOTAiqT0I
# Only needed if the table should be pinned by id instead of by the name PollAnswers.
# `node scripts/airtable-schema.mjs` prints the id (needs the PAT scope schema.bases:write).
AIRTABLE_POLL_TABLE_ID=
