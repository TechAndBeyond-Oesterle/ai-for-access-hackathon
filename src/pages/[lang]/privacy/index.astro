---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import type { Lang } from '../../../i18n/translations';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }];
}

const lang = (Astro.params.lang as Lang) || 'de';
const isDE = lang === 'de';
---

<BaseLayout title={isDE ? 'Datenschutz — AI for Access' : 'Privacy Policy — AI for Access'}>
  <Header lang={lang} />
  <main class="pt-28 pb-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl sm:text-5xl font-bold mb-8 text-accent">{isDE ? 'Datenschutz' : 'Privacy Policy'}</h1>

      <div class="space-y-6 text-sm sm:text-base leading-relaxed" style="color: var(--fg-muted);">
        <div>
          <h2 class="font-display text-lg font-bold mb-2" style="color: var(--fg);">{isDE ? 'Datenerhebung' : 'Data Collection'}</h2>
          <p>{isDE
            ? 'Bei der Anmeldung erheben wir Name, E-Mail-Adresse und Rolle. Optional erfassen wir Alter, Organisation, Angaben zu Essen und Barrierefreiheit, Info-Session, Foto-/Video-Einverständnis und Kinderbetreuung. Teilnehmende geben zusätzlich ihre Kenntnisse, eine Selbsteinschätzung ihrer Fähigkeiten im Vergleich zu Personen aus Arbeit oder Ausbildung und ihren Teamstatus an. Challenge-Präferenzen fragen wir erst später ab.'
            : 'Registration collects your name, email address and role. Optional details include age, organization, food and accessibility needs, info session, photo/video preference and childcare. Participants also provide their knowledge areas, a skill rating compared with people they work or study with, and their team status. We ask about challenge preferences later.'
          }</p>
        </div>

        <div>
          <h2 class="font-display text-lg font-bold mb-2" style="color: var(--fg);">{isDE ? 'Verwendungszweck' : 'Purpose'}</h2>
          <p>{isDE
            ? 'Wir verwenden deine Angaben für die Anmeldung, Event-Kommunikation, Organisation von Essen und Kinderbetreuung sowie für Teamvorschläge für alle Teilnehmenden und spätere Challenge-Vorschläge. Deine Kenntnisse und Teamangaben helfen uns auch, die Qualität der Vorschläge auszuwerten. Ob du einen Teamvorschlag annimmst, entscheidest du selbst.'
            : 'We use your answers for registration, event communication, food and childcare planning, team suggestions for every participant, and later challenge suggestions. Your skill and team answers also help us evaluate the quality of those suggestions. You decide whether to accept a team suggestion.'
          }</p>
        </div>

        <div>
          <h2 class="font-display text-lg font-bold mb-2" style="color: var(--fg);">{isDE ? 'Weitergabe' : 'Data Sharing'}</h2>
          <p>{isDE
            ? 'Dieses Formular übermittelt keine identifizierbaren Anmeldedaten an die Forschungspartnerin. Über eine allfällige Weitergabe für die Studie informieren wir dich gesondert. Sponsor-Unternehmen erhalten keinen Zugang zu Teilnehmer-Daten, es sei denn, du gibst dem ausdrücklich zu.'
            : 'This form does not send identifiable registration data to the research partner. We will provide separate information before any data is shared for the study. Sponsor companies do not receive participant data unless you explicitly consent.'
          }</p>
        </div>

        <div>
          <h2 class="font-display text-lg font-bold mb-2" style="color: var(--fg);">{isDE ? 'Auftragsverarbeiter' : 'Data Processor'}</h2>
          <p>{isDE
            ? 'Zur Verwaltung der Anmeldungen nutzen wir Airtable (Formagrid Inc., 799 Market Street, San Francisco, CA 94103, USA). Die oben genannten Anmeldedaten werden dort gespeichert.'
            : 'We use Airtable (Formagrid Inc., 799 Market Street, San Francisco, CA 94103, USA) to manage registrations. The registration data listed above is stored there.'
          }</p>
          <p class="mt-2"><a href="https://www.airtable.com/privacy" target="_blank" class="text-accent hover:underline">{isDE ? 'Datenschutzerklärung von Airtable' : 'Airtable Privacy Policy'}</a></p>
        </div>

        <div>
          <h2 class="font-display text-lg font-bold mb-2" style="color: var(--fg);">{isDE ? 'Löschung' : 'Deletion'}</h2>
          <p>{isDE
            ? 'Du kannst jederzeit die Löschung deiner Daten verlangen per E-Mail an hackathon@powercoders.org. Deine Daten werden spätestens 6 Monate nach dem Event gelöscht.'
            : 'You can request deletion of your data at any time by emailing hackathon@powercoders.org. Your data will be deleted no later than 6 months after the event.'
          }</p>
        </div>

        <div>
          <h2 class="font-display text-lg font-bold mb-2" style="color: var(--fg);">{isDE ? 'Fotos & Videos' : 'Photos & Videos'}</h2>
          <p>{isDE
            ? 'Während des Events werden Fotos und Videos gemacht. Mit deiner Teilnahme erklärst du dich damit einverstanden, dass diese für die Dokumentation und Kommunikation des Events verwendet werden können. Wenn du nicht fotografiert werden möchtest, teile dies bitte dem Organisationsteam mit.'
            : 'Photos and videos will be taken during the event. By participating, you agree that these may be used for event documentation and communication. If you do not wish to be photographed, please inform the organizing team.'
          }</p>
        </div>

        <div>
          <h2 class="font-display text-lg font-bold mb-2" style="color: var(--fg);">{isDE ? 'Kontakt' : 'Contact'}</h2>
          <p>E-Mail: <a href="mailto:hackathon@powercoders.org" class="text-accent hover:underline">hackathon@powercoders.org</a></p>
        </div>
      </div>

      <div class="mt-12">
        <a href={`/${lang}/`} class="text-sm text-accent hover:underline">← {isDE ? 'Zurück zur Startseite' : 'Back to homepage'}</a>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
