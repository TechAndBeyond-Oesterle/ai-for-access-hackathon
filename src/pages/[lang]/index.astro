---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import HackInChurch from '../../components/HackInChurch.astro';
import Vision from '../../components/Vision.astro';
import Timeline from '../../components/Timeline.astro';
import Mentoring from '../../components/Mentoring.astro';
import Challenges from '../../components/Challenges.astro';
import InlineCta from '../../components/InlineCta.astro';
import Audience from '../../components/Audience.astro';
import Prizes from '../../components/Prizes.astro';
import Hosts from '../../components/Hosts.astro';
import Sponsors from '../../components/Sponsors.astro';
import Location from '../../components/Location.astro';
import SignupForm from '../../components/SignupForm';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import type { Lang } from '../../i18n/translations';
import { useTranslations } from '../../i18n/utils';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { lang: 'de' } },
    { params: { lang: 'en' } },
  ];
}

const lang = (Astro.params.lang as Lang) || 'de';
const t = useTranslations(lang);
const mood = (Astro.url.searchParams.get('mood') as string) || 'sacred';
---

<BaseLayout title={`AI for Access — ${t('hero.event')}`}>
  <Header lang={lang} mood={mood} />

  <main>
    <Hero lang={lang} />
    <HackInChurch lang={lang} />
    <Vision lang={lang} />
    <Challenges lang={lang} />

    <!-- Inline CTA after Challenges -->
    <InlineCta lang={lang} text={t('cta.inline.challenges')} />

    <Timeline lang={lang} />
    <Audience lang={lang} />
    <Mentoring lang={lang} />

    <!-- Inline CTA after Mentoring -->
    <InlineCta lang={lang} text={t('cta.inline.audience')} />

    <Prizes lang={lang} />
    <Hosts lang={lang} />
    <Sponsors lang={lang} />
    <Location lang={lang} />

    <!-- Signup Section -->
    <section id="signup" class="relative py-24 sm:py-32">
      <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0.15;"></div>

      <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] opacity-[0.03] rounded-full"
          style="background: radial-gradient(circle, var(--accent), transparent 70%);"
        ></div>
      </div>

      <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-4">
          <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
            {t('signup.label')}
          </span>
        </div>

        <h2 class="font-display text-3xl sm:text-5xl md:text-6xl font-bold text-center tracking-tight mb-4">
          {t('signup.headline')}
        </h2>

        <p class="text-lg text-muted text-center mb-12">
          {t('signup.sub')}
        </p>

        <SignupForm lang={lang} client:visible />

        <!-- Privacy note -->
        <p class="mt-6 text-center text-xs text-muted" style="opacity: 0.6;">
          {lang === 'de'
            ? 'Mit der Anmeldung akzeptierst du unseren '
            : 'By signing up you accept our '}
          <a href={`/${lang}/coc/`} class="text-accent hover:underline">Code of Conduct</a>
          {lang === 'de' ? ' und die ' : ' and '}
          <a href={`/${lang}/privacy/`} class="text-accent hover:underline">{lang === 'de' ? 'Datenschutzerklärung' : 'Privacy Policy'}</a>.
        </p>
      </div>
    </section>

    <Faq lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
