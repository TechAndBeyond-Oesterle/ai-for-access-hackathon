---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Hosts from '../../components/Hosts.astro';
import Vision from '../../components/Vision.astro';
import Timeline from '../../components/Timeline.astro';
import Mentoring from '../../components/Mentoring.astro';
import Challenges from '../../components/Challenges.astro';
import InlineCta from '../../components/InlineCta.astro';
import Audience from '../../components/Audience.astro';
import Prizes from '../../components/Prizes.astro';
import Sponsors from '../../components/Sponsors.astro';
import Location from '../../components/Location.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import type { Lang } from '../../i18n/translations';
import { useTranslations } from '../../i18n/utils';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { lang: 'de' } },
    { params: { lang: 'en' } },
  ];
}

const lang = (Astro.params.lang as Lang) || 'de';
const t = useTranslations(lang);
---

<BaseLayout title={`AI for Access — ${t('hero.event')}`}>
  <Header lang={lang} />

  <main>
    <Hero lang={lang} />
    <Vision lang={lang} />
    <Challenges lang={lang} />

    <Timeline lang={lang} />
    <Audience lang={lang} />
    <Mentoring lang={lang} />

    <!-- Inline CTA after Mentoring -->
    <InlineCta lang={lang} text={t('cta.inline.audience')} />

    <Prizes lang={lang} />

    <Hosts lang={lang} />

    <Sponsors lang={lang} />

    <Location lang={lang} />

    <!-- Signup CTA -->
    <section id="signup" class="relative py-24 sm:py-32">
      <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>
      <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
          {t('signup.label')}
        </span>
        <h2 class="font-display text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight mt-4 mb-4">
          {t('signup.headline')}
        </h2>
        <p class="text-lg text-muted mb-8">
          {t('signup.sub')}
        </p>
        <a href={`/${lang}/register/`}
          class="inline-block px-8 py-4 text-base font-semibold rounded-full transition-all duration-300 hover:scale-[1.02] hover:shadow-lg active:scale-[0.98]"
          style="background-color: var(--accent); color: var(--bg);"
        >
          {t('hero.cta.primary')}
        </a>
      </div>
    </section>

    <Faq lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
