---
import '../styles/global.css';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const mood = (Astro.url.searchParams.get('mood') as string) || 'violet';

const defaultTitle = lang === 'de'
  ? 'AI for Access — 10 Jahre Powercoders Hackathon'
  : 'AI for Access — 10 Years Powercoders Hackathon';

const defaultDescription = lang === 'de'
  ? 'Du musst nicht coden können. Du musst ein Problem verstehen. 20.–21. November 2026, Stadtkloster Frieden, Bern. 100 Plätze.'
  : 'You don\'t need to code. You need to understand a problem. November 20–21, 2026, Stadtkloster Frieden, Bern. 100 spots.';

const { title = defaultTitle, description = defaultDescription } = Astro.props;
const siteUrl = 'https://aiforaccess.ch'; // TODO: update when domain is confirmed
const currentUrl = `${siteUrl}/${lang}/`;
---

<!doctype html>
<html lang={lang} data-mood={mood}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="de" href="/de/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en'} />
    <meta property="og:site_name" content="AI for Access" />
    <meta property="og:image" content={`${siteUrl}/og/${lang}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og/${lang}.png`} />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />
  </body>
</html>
