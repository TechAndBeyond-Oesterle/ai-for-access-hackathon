---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const roles = [
  { title: t('audience.domain'), desc: t('audience.domain.desc') },
  { title: t('audience.design'), desc: t('audience.design.desc') },
  { title: t('audience.dev'), desc: t('audience.dev.desc') },
  { title: t('audience.pm'), desc: t('audience.pm.desc') },
  { title: t('audience.students'), desc: t('audience.students.desc') },
  { title: t('audience.alumni'), desc: t('audience.alumni.desc') },
  { title: t('audience.newcomer'), desc: t('audience.newcomer.desc') },
  { title: t('audience.career'), desc: t('audience.career.desc') },
];
---

<section id="audience" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('audience.label')}
      </span>
    </div>

    <h2 class="font-display text-[clamp(2rem,8vw,5rem)] font-bold text-center tracking-[-0.03em] uppercase mb-4">
      {t('audience.headline')}
    </h2>

    <p class="text-lg text-muted text-center max-w-2xl mx-auto mb-16">
      {t('audience.sub')}
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-0">
      {roles.map((role) => (
        <div class="card-bold group text-center p-5 sm:p-6 -mt-[2px] -ml-[2px]">
          <h3 class="font-display text-sm sm:text-base font-bold uppercase tracking-wide mb-2">{role.title}</h3>
          <p class="text-xs text-muted">{role.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
