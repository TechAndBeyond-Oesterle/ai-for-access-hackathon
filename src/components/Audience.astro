---

<section id="audience" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0.15;"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('audience.label')}
      </span>
    </div>

    <h2 class="font-display text-3xl sm:text-5xl md:text-6xl font-bold text-center tracking-tight mb-4">
      {t('audience.headline')}
    </h2>

    <p class="text-lg text-muted text-center max-w-2xl mx-auto mb-16">
      {t('audience.sub')}
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {roles.map((role) => (
        <div class="group text-center p-5 sm:p-6 rounded-2xl border transition-all duration-300 hover:border-accent/30 hover:-translate-y-1"
          style="border-color: color-mix(in srgb, var(--fg) 6%, transparent);"
        >
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl mb-4 transition-transform group-hover:scale-110"
            style="background: color-mix(in srgb, var(--accent) 10%, transparent);"
          >
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={role.icon} />
            </svg>
          </div>
          <h3 class="font-display text-sm sm:text-base font-bold mb-1">{role.title}</h3>
          <p class="text-xs text-muted">{role.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
