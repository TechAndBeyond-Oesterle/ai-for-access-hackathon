---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  text?: string;
}

const { lang, text } = Astro.props;
const t = useTranslations(lang);
const label = text || t('cta.inline.signup');
---

<div class="py-12 text-center">
  <a
    href="#signup"
    class="group inline-flex items-center gap-3 px-8 py-4 text-sm font-bold uppercase tracking-widest transition-all duration-200 cta-glow"
    style="background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 80%, var(--accent-alt))); color: #fff;"
  >
    {label}
    <span class="transition-transform group-hover:translate-x-2">&rarr;</span>
  </a>
</div>
