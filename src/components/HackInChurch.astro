---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="church" class="relative py-24 sm:py-32 overflow-hidden">
  <!-- Decorative arch border top -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0.3;"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Label -->
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('church.label')}
      </span>
    </div>

    <!-- Headline -->
    <h2 class="font-display text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-center tracking-tight leading-tight mb-6">
      {t('church.headline')}
    </h2>

    <!-- Statement -->
    <p class="text-lg sm:text-xl md:text-2xl text-muted text-center max-w-3xl mx-auto mb-16 font-light leading-relaxed">
      {t('church.statement')}
    </p>

    <!-- Church Gallery — Real photos -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 mb-12">
      <!-- Image 1 — Interior / Stadtkloster Saal -->
      <div class="group relative aspect-[3/4] md:aspect-[2/3] rounded-2xl overflow-hidden bg-raised">
        <img
          src="/images/location/stadtkloster-interior.jpg"
          alt={t('church.img2')}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg)] via-[var(--bg)]/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6">
          <p class="text-sm font-mono text-accent tracking-wider drop-shadow-lg">{t('church.img2')}</p>
        </div>
      </div>

      <!-- Image 2 — Portal / Eingang -->
      <div class="group relative aspect-[3/4] md:aspect-[2/3] rounded-2xl overflow-hidden bg-raised">
        <img
          src="/images/location/friedenskirche-portal.jpg"
          alt={t('church.img1')}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg)] via-[var(--bg)]/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6">
          <p class="text-sm font-mono text-accent tracking-wider drop-shadow-lg">{t('church.img1')}</p>
        </div>
      </div>

      <!-- Image 3 — Fassade / Gesamtansicht -->
      <div class="group relative aspect-[3/4] md:aspect-[2/3] rounded-2xl overflow-hidden bg-raised">
        <img
          src="/images/location/friedenskirche-front.jpg"
          alt={t('church.img3')}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg)] via-[var(--bg)]/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6">
          <p class="text-sm font-mono text-accent tracking-wider drop-shadow-lg">{t('church.img3')}</p>
        </div>
      </div>
    </div>

    <!-- Photo credit -->
    <p class="text-center text-[10px] text-muted/50 font-mono mb-8">
      {lang === 'de' ? 'Fotos' : 'Photos'}: Wikimedia Commons (CC) · stadtkloster-frieden.ch
    </p>

    <!-- CTA -->
    <div class="text-center">
      <a
        href="https://www.stadtkloster-frieden.ch/#grosser-saal"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline underline-offset-4 transition-all"
      >
        {t('church.cta')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</section>
