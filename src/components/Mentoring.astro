---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const mentors = [
  { title: t('mentoring.sherpa.title'), desc: t('mentoring.sherpa.desc'), highlight: true },
  { title: t('mentoring.domain.title'), desc: t('mentoring.domain.desc'), highlight: false },
  { title: t('mentoring.tech.title'), desc: t('mentoring.tech.desc'), highlight: false },
  { title: t('mentoring.pitch.title'), desc: t('mentoring.pitch.desc'), highlight: false },
];
---

<section id="mentoring" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('mentoring.label')}
      </span>
    </div>

    <h2 class="font-display text-[clamp(2rem,8vw,5rem)] font-bold text-center tracking-[-0.03em] uppercase mb-4">
      {t('mentoring.headline')}
    </h2>

    <p class="text-lg text-muted text-center max-w-2xl mx-auto mb-16">
      {t('mentoring.sub')}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-0">
      {mentors.map((m) => (
        <div
          class:list={[
            'card-bold p-6 -mt-[2px] -ml-[2px] relative',
            m.highlight && 'border-accent!',
            m.highlight && 'card-bold--elevated',
          ]}
          style={m.highlight ? `border-color: var(--accent) !important; background: color-mix(in srgb, var(--accent) 5%, var(--bg-raised));` : ''}
        >
          <h3 class="font-display text-base sm:text-lg font-bold uppercase tracking-wide mb-3">{m.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{m.desc}</p>
          {m.highlight && (
            <div class="absolute top-3 right-3 w-3 h-3" style="background: var(--accent);"></div>
          )}
        </div>
      ))}
    </div>

    <!-- Mentor CTA -->
    <div class="mt-12 text-center">
      <a
        href={`/${lang}/mentors`}
        class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-accent hover:underline underline-offset-4 transition-all"
      >
        {t('mentoring.cta')}
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</section>
