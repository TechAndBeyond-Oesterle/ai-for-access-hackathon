---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const prizes = [
  { title: t('prizes.main'), desc: t('prizes.main.desc'), accent: true },
  { title: t('prizes.newcomer'), desc: t('prizes.newcomer.desc'), accent: false },
  { title: t('prizes.company'), desc: t('prizes.company.desc'), accent: false },
  { title: t('prizes.public'), desc: t('prizes.public.desc'), accent: false },
];

const criteria = [
  t('prizes.c1'),
  t('prizes.c2'),
  t('prizes.c3'),
  t('prizes.c4'),
  t('prizes.c5'),
];
---

<section id="prizes" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('prizes.label')}
      </span>
    </div>

    <h2 class="font-display text-[clamp(2rem,8vw,5rem)] font-bold text-center tracking-[-0.03em] uppercase mb-12">
      {t('prizes.headline')}
    </h2>

    <!-- Prize pool — funding to keep building -->
    <div
      class="card-bold card-bold--elevated mx-auto max-w-2xl text-center p-8 sm:p-10 mb-16 border-accent!"
      style="border-color: var(--accent) !important; background: color-mix(in srgb, var(--accent) 6%, var(--bg-raised));"
    >
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-muted block mb-3">
        {t('prizes.pool.label')}
      </span>
      <div class="flex items-baseline justify-center gap-2">
        <span class="text-sm sm:text-base font-mono uppercase tracking-widest text-muted">
          {t('prizes.pool.upto')}
        </span>
        <span class="font-display font-bold tracking-[-0.02em] text-[clamp(2.5rem,10vw,4.5rem)] leading-none text-accent">
          {t('prizes.pool.amount')}
        </span>
      </div>
      <p class="text-sm sm:text-base text-muted mt-4 max-w-md mx-auto">
        {t('prizes.pool.note')}
      </p>
    </div>

    <!-- Prize Cards — bold flat grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-0 mb-16">
      {prizes.map((prize) => (
        <div
          class:list={[
            'card-bold p-6 sm:p-8 -mt-[2px] -ml-[2px] relative',
            prize.accent && 'border-accent!',
            prize.accent && 'card-bold--elevated',
          ]}
          style={prize.accent ? `border-color: var(--accent) !important; background: color-mix(in srgb, var(--accent) 5%, var(--bg-raised));` : ''}
        >
          <h3 class="font-display text-lg sm:text-xl font-bold uppercase tracking-wide mb-2">{prize.title}</h3>
          <p class="text-sm text-muted">{prize.desc}</p>
          {prize.accent && (
            <div class="absolute top-4 right-4 w-3 h-3" style="background: var(--accent);"></div>
          )}
        </div>
      ))}
    </div>

    <!-- Criteria — stark horizontal -->
    <div class="text-center">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-muted mb-6 block">
        {t('prizes.criteria')}
      </span>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {criteria.map((c) => (
          <span
            class="px-4 py-2 text-sm font-bold uppercase tracking-widest border-2 border-accent text-accent transition-colors hover:bg-accent hover:text-white hover:border-accent"
          >
            {c}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
