---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';
import Countdown from './Countdown';
import powercodersLogo from '../../public/images/logos/powercoders.svg?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Background: venue photo with theme-adaptive overlay -->
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat hero-photo"
      style="background-image: url('/images/location/stadtkloster-interior.jpg');"
    ></div>
    <!-- Overlay uses CSS var(--bg) so it adapts to dark/light -->
    <div class="absolute inset-0 hero-overlay"></div>
    <div class="absolute inset-0 hero-grid"></div>
    <!-- Accent glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] opacity-[0.06] rounded-full"
      style="background: radial-gradient(circle, var(--accent), transparent 70%);"
    ></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 pt-24 pb-16 sm:pt-28">
    <a href="https://powercoders.org" class="anniversary-mark mb-8 inline-flex items-center gap-4 sm:gap-5">
      <span class="anniversary-number font-display">10</span>
      <span class="block min-w-0">
        <span class="flex flex-col sm:flex-row sm:items-center gap-2 text-lg sm:text-xl font-bold leading-tight">
          <span>{t('hero.anniversary.title')}</span>
          <span class="anniversary-logo" role="img" aria-label="Powercoders" set:html={powercodersLogo} />
        </span>
        <span class="block mt-1 text-xs sm:text-sm leading-snug">{t('hero.anniversary.description')}</span>
      </span>
    </a>

    <!-- Main headline -->
    <h1 class="animate-fade-in font-display leading-[0.85] tracking-[-0.04em]">
      <span class="block text-[clamp(3rem,14vw,12rem)] font-bold neon-text">{t('hero.title.line1')}</span>
      <span class="block text-[clamp(2.5rem,10vw,8rem)] font-bold mt-1">{t('hero.title.line2')}</span>
    </h1>

    <!-- Subtitle — Vibe Coding + AI -->
    <div class="animate-fade-in-delay-1 mt-6 max-w-xl">
      <div class="w-16 h-1 mb-4" style="background: linear-gradient(90deg, var(--accent), var(--accent-alt));"></div>
      <p class="text-base sm:text-lg md:text-xl font-medium leading-snug">
        {t('hero.subtitle')}
      </p>
    </div>

    <!-- 10x10x10 Motto as secondary -->
    <p class="animate-fade-in-delay-2 mt-4 text-sm sm:text-base font-mono text-muted">
      {t('hero.tagline')}
    </p>

    <!-- Countdown -->
    <div class="animate-fade-in-delay-2 mt-10">
      <Countdown lang={lang} client:load />
    </div>

    <!-- Meta bar -->
    <div class="animate-fade-in-delay-3 mt-10 flex flex-wrap items-center gap-6 text-sm font-mono">
      <span style="color: var(--accent);">{t('hero.date')}</span>
      <span style="color: var(--fg-muted);">|</span>
      <a href="#location" class="hover:text-[var(--accent)] transition-colors" style="color: var(--fg-muted);">{t('hero.location')}</a>
      <span style="color: var(--fg-muted);">|</span>
      <span style="color: var(--accent-alt);">{t('hero.scarcity')}</span>
      <span style="color: var(--fg-muted);">|</span>
      <span style="color: var(--fg-muted);">{t('hero.social_proof')}</span>
    </div>

    <!-- CTAs -->
    <div class="animate-fade-in-delay-3 mt-8 flex flex-wrap items-center gap-3">
      <a href={`/${lang}/register/`}
        class="group inline-flex items-center gap-2 px-8 py-4 text-sm font-bold uppercase tracking-widest transition-all duration-200 cta-glow"
        style="background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 80%, var(--accent-alt))); color: #fff;"
      >
        {t('hero.cta.primary')}
        <span class="transition-transform group-hover:translate-x-2">&rarr;</span>
      </a>
      <a href="#challenges"
        class="inline-flex items-center gap-2 px-8 py-4 text-sm font-bold uppercase tracking-widest border-2 transition-all duration-200 hover:bg-[var(--accent)] hover:text-white hover:border-[var(--accent)]"
        style="border-color: color-mix(in srgb, var(--fg) 20%, transparent);"
      >
        {t('hero.cta.secondary')}
      </a>
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 pointer-events-none z-20 hero-bottom-fade"></div>
</section>

<style>
  .anniversary-mark {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 100%;
    padding: 0.75rem 1.25rem 0.75rem 0.875rem;
    background: var(--accent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 18%), 0 6px 20px rgb(112 24 49 / 12%);
    color: white;
  }

  .anniversary-mark::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 6%) 42%, rgb(255 255 255 / 22%) 50%, rgb(255 255 255 / 6%) 58%, transparent 70%);
    transform: translateX(-120%);
    animation: anniversary-shine 8s ease-in-out infinite;
  }

  @keyframes anniversary-shine {
    0%, 65% { transform: translateX(-120%); }
    90%, 100% { transform: translateX(120%); }
  }

  .anniversary-number {
    font-size: 4rem;
    line-height: 0.85;
    border-right: 1px solid rgb(255 255 255 / 45%);
    padding-right: 1rem;
    flex-shrink: 0;
  }

  .anniversary-logo {
    display: block;
    width: 11rem;
    max-width: 100%;
  }

  .anniversary-logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .anniversary-logo :global(#Fill-1),
  .anniversary-logo :global(#Fill-2),
  .anniversary-logo :global(#Fill-8) {
    fill: white;
  }

  .anniversary-mark:hover {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 25%), 0 8px 24px rgb(112 24 49 / 20%);
  }

  .anniversary-mark:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .anniversary-mark::before {
      animation: none;
    }
  }
</style>
