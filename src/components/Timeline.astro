---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const friday = [
  { time: t('timeline.fri.1.time'), title: t('timeline.fri.1.title'), desc: t('timeline.fri.1.desc'), highlight: false, dur: 0.5 },
  { time: t('timeline.fri.2.time'), title: t('timeline.fri.2.title'), desc: t('timeline.fri.2.desc'), highlight: true, dur: 0.5 },
  { time: t('timeline.fri.3.time'), title: t('timeline.fri.3.title'), desc: t('timeline.fri.3.desc'), highlight: true, dur: 1 },
  { time: t('timeline.fri.4.time'), title: t('timeline.fri.4.title'), desc: t('timeline.fri.4.desc'), highlight: false, dur: 1 },
  { time: t('timeline.fri.5.time'), title: t('timeline.fri.5.title'), desc: t('timeline.fri.5.desc'), highlight: false, dur: 0 },
];

const saturday = [
  { time: t('timeline.sat.1.time'), title: t('timeline.sat.1.title'), desc: t('timeline.sat.1.desc'), highlight: false, dur: 0.5 },
  { time: t('timeline.sat.2.time'), title: t('timeline.sat.2.title'), desc: t('timeline.sat.2.desc'), highlight: true, dur: 0.5 },
  { time: t('timeline.sat.2c.time'), title: t('timeline.sat.2c.title'), desc: t('timeline.sat.2c.desc'), highlight: false, dur: 2.5 },
  { time: t('timeline.sat.3.time'), title: t('timeline.sat.3.title'), desc: t('timeline.sat.3.desc'), highlight: false, dur: 1.5 },
  { time: t('timeline.sat.3b.time'), title: t('timeline.sat.3b.title'), desc: t('timeline.sat.3b.desc'), highlight: true, dur: 1 },
  { time: t('timeline.sat.4.time'), title: t('timeline.sat.4.title'), desc: t('timeline.sat.4.desc'), highlight: false, dur: 3 },
  { time: t('timeline.sat.5.time'), title: t('timeline.sat.5.title'), desc: t('timeline.sat.5.desc'), highlight: true, dur: 0.75 },
  { time: t('timeline.sat.5b.time'), title: t('timeline.sat.5b.title'), desc: t('timeline.sat.5b.desc'), highlight: false, dur: 0.25 },
  { time: t('timeline.sat.6.time'), title: t('timeline.sat.6.title'), desc: t('timeline.sat.6.desc'), highlight: true, dur: 1.25 },
  { time: t('timeline.sat.7.time'), title: t('timeline.sat.7.title'), desc: t('timeline.sat.7.desc'), highlight: true, dur: 0.75 },
  { time: t('timeline.sat.8.time'), title: t('timeline.sat.8.title'), desc: t('timeline.sat.8.desc'), highlight: false, dur: 0 },
];

const friLabel = t('timeline.friday');
const satLabel = t('timeline.saturday');
---

<section id="timeline" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('timeline.label')}
      </span>
    </div>

    <h2 class="font-display text-[clamp(2rem,8vw,5rem)] font-bold text-center tracking-[-0.03em] uppercase mb-16 sm:mb-20">
      {t('timeline.headline')}
    </h2>

    <!-- Railway Timetable layout -->
    <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-0">

      <!-- Friday sidebar -->
      <div class="border-2 p-6 lg:border-r-0" style="border-color: color-mix(in srgb, var(--fg) 15%, transparent);">
        <!-- Pre-event note -->
        <div class="mb-6 p-3" style="border: 1px dashed color-mix(in srgb, var(--accent) 60%, transparent);">
          <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-accent">{t('timeline.preevent.label')}</span>
          <p class="text-sm font-bold uppercase tracking-wide mt-1">{t('timeline.preevent.title')}</p>
          <p class="text-xs mt-0.5 text-muted">{t('timeline.preevent.desc')}</p>
        </div>
        <h3 class="text-xs font-mono uppercase tracking-[0.3em] mb-6 text-muted">{friLabel}</h3>
        {friday.map((item) => (
          <div class="flex items-baseline gap-3 py-3" style="border-bottom: 1px solid color-mix(in srgb, var(--fg) 8%, transparent);">
            <span class="font-display text-2xl sm:text-3xl font-bold leading-none tracking-tight">{item.time}</span>
            <div>
              <span class="text-sm font-bold uppercase tracking-wide">{item.title}</span>
              <p class="text-xs mt-0.5 text-muted">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Saturday main grid -->
      <div class="border-2" style="border-color: color-mix(in srgb, var(--fg) 15%, transparent);">
        <div class="p-4 border-b-2 flex items-center justify-between" style="border-color: color-mix(in srgb, var(--fg) 15%, transparent);">
          <h3 class="text-xs font-mono uppercase tracking-[0.3em] text-muted">{satLabel}</h3>
          <span class="text-xs font-mono uppercase tracking-wider text-accent">12h</span>
        </div>

        <!-- Time blocks -->
        <div class="divide-y-2" style="border-color: color-mix(in srgb, var(--fg) 15%, transparent);">
          {saturday.map((item) => (
            <div
              class:list={[
                'group p-4 sm:p-5 transition-colors duration-150',
                item.highlight ? 'hover:bg-[color-mix(in_srgb,var(--accent)_8%,transparent)]' : '',
              ]}
              style={`min-height: ${Math.max(item.dur * 35, 60)}px; border-color: color-mix(in srgb, var(--fg) 15%, transparent);`}
            >
              <div class="flex items-start gap-4 sm:gap-6">
                <span class="font-display text-[clamp(1.5rem,4vw,3rem)] font-bold shrink-0 leading-none tracking-tight" style={`color: ${item.highlight ? 'var(--accent)' : 'color-mix(in srgb, var(--fg) 10%, transparent)'};`}>
                  {item.time}
                </span>
                <div class="pt-1">
                  <h4 class="text-sm sm:text-base font-bold uppercase tracking-wide">
                    {item.title}
                  </h4>
                  <p class="text-xs sm:text-sm mt-1 text-muted">
                    {item.desc}
                  </p>
                </div>
                {item.highlight && (
                  <span class="ml-auto shrink-0 w-3 h-3 mt-2 group-hover:scale-150 transition-transform" style="background: var(--accent);"></span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
