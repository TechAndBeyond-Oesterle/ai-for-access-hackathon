---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const paths = [
  { num: '01', title: t('challenges.path1.title'), desc: t('challenges.path1.desc') },
  { num: '02', title: t('challenges.path2.title'), desc: t('challenges.path2.desc') },
  { num: '03', title: t('challenges.path3.title'), desc: t('challenges.path3.desc') },
];

const examples = [
  { title: t('challenges.ex1.title'), desc: t('challenges.ex1.desc'), tag: 'Digital Inclusion' },
  { title: t('challenges.ex2.title'), desc: t('challenges.ex2.desc'), tag: 'Legal Tech' },
  { title: t('challenges.ex3.title'), desc: t('challenges.ex3.desc'), tag: 'Accessibility' },
  { title: t('challenges.ex4.title'), desc: t('challenges.ex4.desc'), tag: 'Integration' },
  { title: t('challenges.ex5.title'), desc: t('challenges.ex5.desc'), tag: 'Health' },
  { title: t('challenges.ex6.title'), desc: t('challenges.ex6.desc'), tag: 'Employment' },
];
---

<section id="challenges" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('challenges.label')}
      </span>
    </div>

    <h2 class="font-display text-[clamp(2rem,8vw,5rem)] font-bold text-center tracking-[-0.03em] uppercase mb-16 sm:mb-20">
      {t('challenges.headline')}
    </h2>

    <!-- Three paths — bold flat list with oversized numbers -->
    <div class="space-y-0 mb-16">
      {paths.map((path) => (
        <div class="card-bold group flex items-start gap-6 sm:gap-10 p-6 sm:p-8 -mt-[2px]">
          <span class="brutal-number shrink-0" style="color: var(--fg-muted); opacity: 0.1;">
            {path.num}
          </span>
          <div class="pt-4 sm:pt-6">
            <h3 class="font-display text-xl sm:text-2xl md:text-3xl font-bold uppercase tracking-wide mb-2">
              {path.title}
            </h3>
            <p class="text-sm sm:text-base leading-relaxed max-w-lg text-muted">{path.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Example challenges — stark grid -->
    <div class="mb-8 flex items-center gap-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-muted">{t('challenges.examples')}</span>
      <div class="flex-1 h-[2px]" style="background: color-mix(in srgb, var(--fg) 10%, transparent);"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-0">
      {examples.map((ex) => (
        <div class="card-bold p-5 -mt-[2px] -ml-[2px] group">
          <div class="flex items-start justify-between gap-2 mb-3">
            <h4 class="font-display text-sm sm:text-base font-bold uppercase tracking-wide">{ex.title}</h4>
            <span class="text-[9px] font-mono px-2 py-0.5 uppercase tracking-widest shrink-0" style="border: 1px solid color-mix(in srgb, var(--fg) 15%, transparent); color: var(--fg-muted);">
              {ex.tag}
            </span>
          </div>
          <p class="text-xs sm:text-sm leading-relaxed text-muted">{ex.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
