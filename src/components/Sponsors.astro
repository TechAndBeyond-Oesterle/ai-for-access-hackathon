---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const confirmedSponsors = [
  {
    name: 'BFH',
    logo: '/images/logos/bfh.svg',
    url: 'https://www.bfh.ch',
    tier: 'challenge',
    keepColor: true,
  },
  {
    name: 'Powercoders',
    logo: '/images/logos/powercoders.svg',
    url: 'https://powercoders.org',
    tier: 'community',
  },
  {
    name: 'Tech & Beyond',
    logo: '/images/logos/tech-and-beyond.jpg',
    url: 'https://jonasoesterle.de/tech',
    tier: 'community',
  },
];

const tiers = [
  { key: 'challenge', name: t('sponsors.tier.challenge'), openSlots: 2 },
  { key: 'gold', name: t('sponsors.tier.gold'), openSlots: 3 },
  { key: 'silver', name: t('sponsors.tier.silver'), openSlots: 4 },
  { key: 'tool', name: t('sponsors.tier.tool'), openSlots: 3 },
  { key: 'community', name: t('sponsors.tier.community'), openSlots: 2 },
];
---

<section id="sponsors" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('sponsors.label')}
      </span>
    </div>

    <h2 class="font-display text-[clamp(2rem,8vw,5rem)] font-bold text-center tracking-[-0.03em] uppercase mb-16">
      {t('sponsors.headline')}
    </h2>

    <!-- Sponsor tiers -->
    <div class="space-y-10">
      {tiers.map((tier) => {
        const tierSponsors = confirmedSponsors.filter(s => s.tier === tier.key);
        return (
          <div>
            <h3 class="text-xs font-mono tracking-[0.2em] uppercase text-muted text-center mb-5">{tier.name}</h3>
            <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-5">
              {tierSponsors.map((sponsor) => (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center border-2 transition-all duration-150 hover:border-[var(--accent)] w-28 h-14 sm:w-36 sm:h-16 p-2"
                  style="border-color: color-mix(in srgb, var(--fg) 15%, transparent); background: var(--bg-raised);"
                  title={sponsor.name}
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class:list={['max-w-full max-h-full object-contain', sponsor.logo.endsWith('.svg') && !sponsor.keepColor ? 'logo-svg' : '']}
                    style={sponsor.keepColor ? 'opacity: 1;' : sponsor.logo.endsWith('.svg') ? 'opacity: 0.7;' : 'opacity: 0.85;'}
                    loading="lazy"
                  />
                </a>
              ))}
              {Array.from({ length: tier.openSlots }).map(() => (
                <div
                  class="flex items-center justify-center border-2 border-dashed w-28 h-14 sm:w-36 sm:h-16"
                  style="border-color: color-mix(in srgb, var(--fg) 10%, transparent);"
                >
                  <span class="text-[10px] font-mono text-muted/30 tracking-wider uppercase">
                    {t('sponsors.slot.open')}
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- CTA -->
    <div class="mt-14 text-center">
      <a
        href="mailto:hackathon@powercoders.org"
        class="inline-flex items-center gap-2 px-8 py-4 text-base font-semibold border-2 transition-all duration-300 hover:scale-105 cta-glow"
        style="border-color: var(--accent); color: var(--accent); border-radius: var(--radius);"
      >
        {t('sponsors.cta')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
