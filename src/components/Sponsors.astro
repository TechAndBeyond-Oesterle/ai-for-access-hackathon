---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const confirmedSponsors = [
  {
    name: 'TCS',
    logo: '/images/logos/tcs.svg',
    url: 'https://www.tcs.com',
    tier: 'main',
    keepColor: true,
  },
  {
    name: 'BFH',
    logo: '/images/logos/bfh.svg',
    url: 'https://www.bfh.ch',
    tier: 'main',
    keepColor: true,
  },
  {
    name: 'Powercoders',
    logo: '/images/logos/powercoders.svg',
    url: 'https://powercoders.org',
    tier: 'community',
  },
  {
    name: 'Tech & Beyond',
    logo: '/images/logos/tech-and-beyond.jpg',
    url: 'https://jonasoesterle.de/tech',
    tier: 'community',
  },
  {
    name: 'antigravity',
    logo: '/images/logos/antigravity.svg',
    url: 'https://antigravity.ch',
    tier: 'community',
  },
  {
    name: 'dreipol',
    logo: '/images/logos/dreipol.svg',
    url: 'https://dreipol.ch',
    tier: 'community',
  },
  {
    name: 'CrowdStrike',
    logo: '/images/logos/crowdstrike.svg',
    url: 'https://www.crowdstrike.com',
    tier: 'community',
  },
  {
    name: 'elio tax',
    logo: '/images/logos/elio-tax.png',
    url: 'https://www.elio-tax.com/en/',
    tier: 'community',
  },
  {
    name: 'EBP',
    logo: '/images/logos/ebp.png',
    url: 'https://www.ebp.global/ch-de',
    tier: 'community',
  },
  {
    name: 'Capacity',
    logo: '/images/logos/capacity.png',
    url: 'https://www.capacity.swiss',
    tier: 'community',
  },
  {
    name: 'Lovable',
    logo: '/images/logos/lovable.svg',
    url: 'https://lovable.dev',
    tier: 'ai',
    keepColor: true,
  },
  {
    name: 'Upgrid',
    logo: '/images/logos/upgrid.png',
    url: 'https://upgrid.ch/de',
    tier: 'micro',
    keepColor: true,
    bg: '#000',
  },
];

// Box size, label size and open-slot count scale down the further a tier sits from the top.
const scales = {
  large: {
    box: 'w-40 h-20 sm:w-48 sm:h-24 p-3 border-2',
    label: 'text-sm font-mono tracking-[0.2em] uppercase text-center mb-5',
  },
  medium: {
    box: 'w-28 h-14 sm:w-36 sm:h-16 p-2 border-2',
    label: 'text-xs font-mono tracking-[0.2em] uppercase text-muted text-center mb-5',
  },
  small: {
    box: 'w-20 h-10 sm:w-24 sm:h-12 p-1.5 border',
    label: 'text-[10px] font-mono tracking-[0.15em] uppercase text-muted/60 text-center mb-4',
  },
  tiny: {
    box: 'w-16 h-8 sm:w-20 sm:h-10 p-1 border',
    label: 'text-[10px] font-mono tracking-[0.15em] uppercase text-muted/50 text-center mb-4',
  },
} as const;

const tiers = [
  { key: 'main', name: t('sponsors.tier.main'), openSlots: 1, scale: 'large' as const },
  { key: 'catering', name: t('sponsors.tier.catering'), openSlots: 0, scale: 'large' as const },
  { key: 'location', name: t('sponsors.tier.location'), openSlots: 0, scale: 'large' as const },
  { key: 'ai', name: t('sponsors.tier.ai'), openSlots: 2, scale: 'medium' as const },
  { key: 'challenge', name: t('sponsors.tier.challenge'), openSlots: 2, scale: 'medium' as const },
  { key: 'micro', name: t('sponsors.tier.micro'), openSlots: 3, scale: 'small' as const },
  { key: 'community', name: t('sponsors.tier.community'), openSlots: 1, scale: 'tiny' as const },
];
---

<section id="sponsors" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('sponsors.label')}
      </span>
    </div>

    <h2 class="font-display text-[clamp(2rem,8vw,5rem)] font-bold text-center tracking-[-0.03em] uppercase mb-16">
      {t('sponsors.headline')}
    </h2>

    <!-- Sponsor tiers, ordered by prominence -->
    <div class="space-y-10">
      {tiers.map((tier) => {
        const tierSponsors = confirmedSponsors.filter(s => s.tier === tier.key);
        const { box, label } = scales[tier.scale];
        return (
          <div>
            <h3 class={label}>{tier.name}</h3>
            <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-5">
              {tierSponsors.map((sponsor) => (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={['flex items-center justify-center transition-all duration-150 hover:border-[var(--accent)]', box]}
                  style={`border-color: color-mix(in srgb, var(--fg) 15%, transparent); background: ${sponsor.bg ?? 'var(--bg-raised)'};`}
                  title={sponsor.name}
                >
                  <img
                    src={sponsor.logo}
                    alt={sponsor.name}
                    class:list={['max-w-full max-h-full object-contain', sponsor.logo.endsWith('.svg') && !sponsor.keepColor ? 'logo-svg' : '']}
                    style={sponsor.keepColor ? 'opacity: 1;' : sponsor.logo.endsWith('.svg') ? 'opacity: 0.7;' : 'opacity: 0.85;'}
                    loading="lazy"
                  />
                </a>
              ))}
              {Array.from({ length: tier.openSlots }).map(() => (
                <div
                  class:list={['flex items-center justify-center border-dashed', box]}
                  style="border-color: color-mix(in srgb, var(--fg) 10%, transparent);"
                >
                  <span class="text-[10px] font-mono text-muted/30 tracking-wider uppercase">
                    {t('sponsors.slot.open')}
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- CTA -->
    <div class="mt-14 text-center">
      <a
        href="mailto:armelle.ako@powercoders.org"
        class="inline-flex items-center gap-2 px-8 py-4 text-base font-semibold border-2 transition-all duration-300 hover:scale-105 cta-glow"
        style="border-color: var(--accent); color: var(--accent); border-radius: var(--radius);"
      >
        {t('sponsors.cta')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
