---
import type { Lang } from '../i18n/translations';
import { useTranslations, getAlternateLang } from '../i18n/utils';

interface Props {
  lang: Lang;
  mood?: string;
}

const { lang, mood = 'sacred' } = Astro.props;
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);
const search = Astro.url.search;
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  id="site-header"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a
        href={`/${lang}/${search}`}
        class="font-display text-lg sm:text-xl font-bold tracking-tight text-accent transition-opacity hover:opacity-80"
      >
        {t('nav.logo')}
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-6 lg:gap-8">
        <a href="#timeline" class="text-sm text-muted hover:text-accent transition-colors">{t('nav.schedule')}</a>
        <a href="#challenges" class="text-sm text-muted hover:text-accent transition-colors">{t('nav.challenges')}</a>
        <a href="#location" class="text-sm text-muted hover:text-accent transition-colors">{t('nav.location')}</a>

        <!-- Mood Switcher (Live) -->
        <div class="flex items-center gap-2 mood-switcher" aria-label="Theme switcher">
          <button
            data-set-mood="sacred"
            class="mood-dot w-3.5 h-3.5 rounded-full transition-all cursor-pointer"
            style={`background-color: ${mood === 'sacred' ? '#D4A24C' : 'rgba(212,162,76,0.4)'}; transform: ${mood === 'sacred' ? 'scale(1.4)' : 'scale(1)'}; box-shadow: ${mood === 'sacred' ? '0 0 10px #D4A24C50' : 'none'};`}
            title="Sacred Tech"
          />
          <button
            data-set-mood="warmth"
            class="mood-dot w-3.5 h-3.5 rounded-full transition-all cursor-pointer"
            style={`background-color: ${mood === 'warmth' ? '#E8541C' : 'rgba(232,84,28,0.4)'}; transform: ${mood === 'warmth' ? 'scale(1.4)' : 'scale(1)'}; box-shadow: ${mood === 'warmth' ? '0 0 10px #E8541C50' : 'none'};`}
            title="Community Warmth"
          />
          <button
            data-set-mood="bold"
            class="mood-dot w-3.5 h-3.5 rounded-full transition-all cursor-pointer"
            style={`background-color: ${mood === 'bold' ? '#00E5A0' : 'rgba(0,229,160,0.4)'}; transform: ${mood === 'bold' ? 'scale(1.4)' : 'scale(1)'}; box-shadow: ${mood === 'bold' ? '0 0 10px #00E5A050' : 'none'};`}
            title="Bold Future"
          />
        </div>

        <!-- Language Toggle -->
        <a
          href={`/${altLang}/${search}`}
          class="text-sm font-mono text-muted hover:text-accent transition-colors uppercase tracking-wider"
        >
          {altLang}
        </a>

        <!-- CTA -->
        <a
          href="#signup"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-full transition-all duration-300 hover:scale-105"
          style="background-color: var(--accent); color: var(--bg);"
        >
          {t('nav.cta')}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex flex-col gap-1.5 p-2"
        aria-label="Menu"
        aria-expanded="false"
      >
        <span class="block w-6 h-0.5 transition-all" style="background-color: var(--fg);"></span>
        <span class="block w-6 h-0.5 transition-all" style="background-color: var(--fg);"></span>
        <span class="block w-4 h-0.5 transition-all ml-auto" style="background-color: var(--fg);"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute top-full left-0 right-0 border-t"
    style="background-color: var(--bg); border-color: var(--fg-muted);"
  >
    <div class="px-4 py-6 space-y-4">
      <a href="#timeline" class="block text-lg text-muted hover:text-accent transition-colors">{t('nav.schedule')}</a>
      <a href="#challenges" class="block text-lg text-muted hover:text-accent transition-colors">{t('nav.challenges')}</a>
      <a href="#location" class="block text-lg text-muted hover:text-accent transition-colors">{t('nav.location')}</a>
      <hr style="border-color: var(--fg-muted); opacity: 0.2;" />
      <div class="flex items-center gap-3">
        <a
          href={`/${altLang}/${search}`}
          class="text-sm font-mono text-muted hover:text-accent uppercase"
        >
          {altLang}
        </a>
        <div class="flex items-center gap-2 mood-switcher">
          <button data-set-mood="sacred" class="mood-dot w-3.5 h-3.5 rounded-full transition-all cursor-pointer" style="background-color: rgba(212,162,76,0.4);" title="Sacred Tech" />
          <button data-set-mood="warmth" class="mood-dot w-3.5 h-3.5 rounded-full transition-all cursor-pointer" style="background-color: rgba(232,84,28,0.4);" title="Community Warmth" />
          <button data-set-mood="bold" class="mood-dot w-3.5 h-3.5 rounded-full transition-all cursor-pointer" style="background-color: rgba(0,229,160,0.4);" title="Bold Future" />
        </div>
      </div>
      <a
        href="#signup"
        class="block text-center px-5 py-3 text-sm font-semibold rounded-full"
        style="background-color: var(--accent); color: var(--bg);"
      >
        {t('nav.cta')}
      </a>
    </div>
  </div>
</header>

<!-- Header background on scroll + mobile menu toggle + live mood switch -->
<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;

  // Scroll background
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 50;
    header.classList.toggle('backdrop-blur-xl', scrolled);
    header.style.backgroundColor = scrolled ? 'color-mix(in srgb, var(--bg) 85%, transparent)' : 'transparent';
  });

  // Mobile menu
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu.classList.toggle('hidden');
  });
  menu.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    });
  });

  // Live mood switcher
  const moodColors: Record<string, string> = {
    sacred: '#D4A24C',
    warmth: '#E8541C',
    bold: '#00E5A0',
  };

  function updateMoodDots(activeMood: string) {
    document.querySelectorAll<HTMLButtonElement>('.mood-dot').forEach(dot => {
      const m = dot.dataset.setMood!;
      const color = moodColors[m];
      const isActive = m === activeMood;
      dot.style.backgroundColor = isActive ? color : hexToRgba(color, 0.4);
      dot.style.transform = isActive ? 'scale(1.4)' : 'scale(1)';
      dot.style.boxShadow = isActive ? `0 0 10px ${color}50` : 'none';
    });
  }

  function hexToRgba(hex: string, alpha: number): string {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r},${g},${b},${alpha})`;
  }

  // Get initial mood
  const initialMood = document.documentElement.dataset.mood || 'sacred';
  updateMoodDots(initialMood);

  // Click handlers
  document.querySelectorAll<HTMLButtonElement>('[data-set-mood]').forEach(btn => {
    btn.addEventListener('click', () => {
      const mood = btn.dataset.setMood!;
      // Add transition to all elements using CSS variables
      document.documentElement.style.setProperty('--transition-speed', '0.5s');
      document.body.style.transition = 'background-color 0.5s ease, color 0.5s ease';
      // Apply mood
      document.documentElement.dataset.mood = mood;
      updateMoodDots(mood);
      // Update URL without reload
      const url = new URL(window.location.href);
      url.searchParams.set('mood', mood);
      history.replaceState(null, '', url.toString());
    });
  });
</script>
