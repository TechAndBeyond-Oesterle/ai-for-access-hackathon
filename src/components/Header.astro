---
import type { Lang } from '../i18n/translations';
import { useTranslations, getAlternateLang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);
/** Hash targets live on the homepage; use absolute path so subpages don't get `/de/legal/#section`. */
const idx = `/${lang}/`;
---

{/* Dispatch ticker: top status strip + nav */}
<div id="site-header-wrap" class="fixed top-0 left-0 right-0 z-50">
  {/* ——— TICKER BANNER ——— */}
  <div class="header-ticker border-b-2" style="border-color: color-mix(in srgb, var(--accent) 25%, transparent); background: var(--bg-raised);">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-8 sm:h-9 overflow-hidden">
        {/* Left: status indicator + event type */}
        <div class="flex items-center gap-3">
          <span class="ticker-pulse relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping opacity-50" style="background: var(--accent);"></span>
            <span class="relative inline-flex h-2 w-2" style="background: var(--accent);"></span>
          </span>
          <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-[0.3em]" style="color: var(--accent);">
            Hackathon
          </span>
        </div>

        {/* Center: BERN + DATE — the hero data */}
        <div class="flex items-center gap-2 sm:gap-4">
          <span class="text-[10px] sm:text-xs font-mono tracking-[0.2em] text-muted" style="opacity: 0.5;">
            //
          </span>
          <span class="text-xs sm:text-sm font-display font-bold uppercase tracking-[0.15em]">
            Bern
          </span>
          <span class="hidden sm:inline text-muted" style="opacity: 0.3;">
            &mdash;
          </span>
          <span class="text-[10px] sm:text-xs font-mono tracking-widest" style="color: var(--accent-alt);">
            {t('hero.date')}
          </span>
          <span class="text-[10px] sm:text-xs font-mono tracking-[0.2em] text-muted" style="opacity: 0.5;">
            //
          </span>
        </div>

        {/* Right: spots counter */}
        <div class="hidden sm:flex items-center gap-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-muted" style="opacity: 0.5;">
            {t('hero.scarcity')}
          </span>
        </div>
      </div>
    </div>
  </div>

  {/* ——— NAV BAR ——— */}
  <header class="transition-all duration-300 header-nav-bar" id="site-header">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center justify-between h-14 sm:h-16">
        {/* Logo */}
        <a
          href={`/${lang}/`}
          class="inline-flex items-center gap-2 sm:gap-3 transition-opacity hover:opacity-80"
          aria-label="Powercoders"
        >
          <img
            src="/images/logos/powercoders.svg"
            alt="Powercoders"
            class="h-5 sm:h-6 w-auto"
            loading="eager"
            decoding="async"
          />
          <span class="font-mono text-md sm:text-lg font-bold uppercase tracking-wide" style="color: var(--fg);">
            x Tech&amp;Beyond
          </span>
        </a>

        {/* Desktop Nav */}
        <div class="hidden md:flex items-center gap-6 lg:gap-8">
          <a href={`${idx}#timeline`} class="text-sm text-muted hover:text-accent transition-colors font-mono text-xs uppercase tracking-widest">{t('nav.schedule')}</a>
          <a href={`${idx}#challenges`} class="text-sm text-muted hover:text-accent transition-colors font-mono text-xs uppercase tracking-widest">{t('nav.challenges')}</a>
          <a href={`${idx}#location`} class="text-sm text-muted hover:text-accent transition-colors font-mono text-xs uppercase tracking-widest">{t('nav.location')}</a>

          {/* Language */}
          <a
            href={`/${altLang}/`}
            class="text-xs font-mono text-muted hover:text-accent transition-colors uppercase tracking-wider"
          >
            {altLang}
          </a>

          {/* CTA */}
          <a
            href={`${idx}#signup`}
            class="inline-flex items-center gap-2 px-5 py-2 text-xs font-bold uppercase tracking-widest transition-all duration-200 hover:scale-105 cta-glow"
            style="background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 80%, var(--accent-alt))); color: #fff;"
          >
            {t('nav.cta')}
          </a>
        </div>

        {/* Mobile Menu Button */}
        <button
          id="mobile-menu-btn"
          class="md:hidden flex flex-col gap-1.5 p-2"
          aria-label="Menu"
          aria-expanded="false"
        >
          <span class="block w-6 h-0.5 transition-all" style="background-color: var(--fg);"></span>
          <span class="block w-6 h-0.5 transition-all" style="background-color: var(--fg);"></span>
          <span class="block w-4 h-0.5 transition-all ml-auto" style="background-color: var(--fg);"></span>
        </button>
      </nav>
    </div>

    {/* Mobile Menu */}
    <div
      id="mobile-menu"
      class="md:hidden hidden absolute top-full left-0 right-0 border-t-2"
      style="background-color: var(--bg); border-color: color-mix(in srgb, var(--fg) 15%, transparent);"
    >
      <div class="px-4 py-6 space-y-4">
        <a href={`${idx}#timeline`} class="block text-base font-mono uppercase tracking-widest text-muted hover:text-accent transition-colors">{t('nav.schedule')}</a>
        <a href={`${idx}#challenges`} class="block text-base font-mono uppercase tracking-widest text-muted hover:text-accent transition-colors">{t('nav.challenges')}</a>
        <a href={`${idx}#location`} class="block text-base font-mono uppercase tracking-widest text-muted hover:text-accent transition-colors">{t('nav.location')}</a>
        <hr style="border-color: var(--fg-muted); opacity: 0.15;" />
        <div class="flex items-center justify-between">
          <a href={`/${altLang}/`} class="text-sm font-mono text-muted hover:text-accent uppercase tracking-wider">
            {altLang === 'de' ? 'Deutsch' : 'English'}
          </a>
        </div>
        <a
          href={`${idx}#signup`}
          class="block text-center px-5 py-3 text-sm font-bold uppercase tracking-widest"
          style="background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 80%, var(--accent-alt))); color: #fff;"
        >
          {t('nav.cta')}
        </a>
      </div>
    </div>
  </header>
</div>


<!-- Header behavior: scroll background, mobile menu -->
<script>
  const headerWrap = document.getElementById('site-header-wrap')!;
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;

  // Scroll background
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 50;
    const navBar = headerWrap.querySelector('.header-nav-bar') as HTMLElement;
    if (navBar) {
      navBar.classList.toggle('backdrop-blur-xl', scrolled);
      navBar.style.backgroundColor = scrolled ? 'color-mix(in srgb, var(--bg) 90%, transparent)' : 'transparent';
    }
  });

  // Mobile menu
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu.classList.toggle('hidden');
  });
  menu.querySelectorAll('a[href*="#"]').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    });
  });

</script>
