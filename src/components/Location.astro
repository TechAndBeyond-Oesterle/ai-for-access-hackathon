---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="location" class="relative py-24 sm:py-32">
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0.15;"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-4">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('location.label')}
      </span>
    </div>

    <h2 class="font-display text-3xl sm:text-5xl md:text-6xl font-bold text-center tracking-tight mb-16">
      {t('location.headline')}
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- Info side -->
      <div class="space-y-8">
        <!-- Address card -->
        <div class="p-6 sm:p-8 rounded-2xl border"
          style="border-color: color-mix(in srgb, var(--fg) 8%, transparent); background: color-mix(in srgb, var(--bg-raised) 50%, transparent);"
        >
          <div class="flex items-start gap-4 mb-6">
            <div class="flex-shrink-0 w-12 h-12 rounded-2xl flex items-center justify-center"
              style="background: color-mix(in srgb, var(--accent) 10%, transparent);"
            >
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display text-lg font-bold mb-1">{t('location.address')}</h3>
              <p class="text-sm text-muted">{t('location.transit')}</p>
            </div>
          </div>

          <p class="text-sm text-muted leading-relaxed mb-6">
            {t('location.history')}
          </p>

          <a
            href="https://www.stadtkloster-frieden.ch/#grosser-saal"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline underline-offset-4"
          >
            {t('location.link')}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Quick facts -->
        <div class="grid grid-cols-3 gap-3">
          {[
            { num: '800', label: lang === 'de' ? 'Sitzplätze' : 'Seats' },
            { num: '20m', label: lang === 'de' ? 'Deckenhöhe' : 'Ceiling' },
            { num: '1920', label: lang === 'de' ? 'Erbaut' : 'Built' },
          ].map((fact) => (
            <div class="text-center p-4 rounded-xl"
              style="background: color-mix(in srgb, var(--bg-raised) 50%, transparent);"
            >
              <span class="block text-2xl sm:text-3xl font-bold font-mono text-accent">{fact.num}</span>
              <span class="text-xs text-muted font-mono uppercase tracking-wider">{fact.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Photo + Map side -->
      <div class="space-y-4">
        <!-- Church photo -->
        <div class="relative rounded-2xl overflow-hidden aspect-[16/9]">
          <img
            src="/images/location/friedenskirche-back.jpg"
            alt="Friedenskirche Bern — Rückansicht"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 pointer-events-none"
            style="background: linear-gradient(to bottom, transparent 60%, color-mix(in srgb, var(--bg) 60%, transparent) 100%);"
          ></div>
        </div>

        <!-- Map -->
        <div class="relative rounded-2xl overflow-hidden border min-h-[250px]"
          style="border-color: color-mix(in srgb, var(--fg) 8%, transparent);"
        >
          <iframe
            title="Stadtkloster Frieden, Bern"
            class="w-full h-full min-h-[250px]"
            style="border:0; filter: saturate(0.6) contrast(1.1) brightness(0.9);"
            loading="lazy"
            src="https://www.openstreetmap.org/export/embed.html?bbox=7.4280%2C46.9410%2C7.4380%2C46.9460&layer=mapnik&marker=46.9436%2C7.4330"
          ></iframe>
          <div class="absolute inset-0 pointer-events-none"
            style="background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 20%, transparent) 0%, transparent 30%, transparent 70%, color-mix(in srgb, var(--bg) 40%, transparent) 100%);"
          ></div>
        </div>
      </div>
    </div>
  </div>
</section>
