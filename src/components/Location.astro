---
import type { Lang } from '../i18n/translations';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: '1920', label: lang === 'de' ? 'Erbaut' : 'Built' },
  { value: '800', label: lang === 'de' ? 'Plätze' : 'Seats' },
  { value: '20m', label: lang === 'de' ? 'Deckenhöhe' : 'Ceiling' },
];
---

<section id="location" class="relative py-24 sm:py-32 overflow-hidden">
  <div class="absolute top-0 left-0 right-0 h-px accent-divider"></div>

  <!-- Diagonal accent slash — background decoration -->
  <div class="absolute top-0 right-0 w-[400px] h-[800px] opacity-[0.03] pointer-events-none" aria-hidden="true"
    style="background: linear-gradient(135deg, var(--accent), transparent); transform: skewX(-12deg) translateX(30%);"
  ></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Header row — label left, coordinates right -->
    <div class="flex items-end justify-between mb-2">
      <span class="text-xs font-mono tracking-[0.3em] uppercase text-accent">
        {t('location.label')}
      </span>
      <span class="hidden sm:block text-[10px] font-mono tracking-widest uppercase text-muted" style="opacity: 0.4;">
        46.9436°N 7.4330°E
      </span>
    </div>

    <!-- Venue name — massive, left-aligned -->
    <h2 class="font-display text-[clamp(2.5rem,10vw,7rem)] font-bold tracking-[-0.04em] uppercase leading-[0.85] mb-2">
      <span class="block">Stadt&shy;kloster</span>
      <span class="block neon-text">Frieden</span>
    </h2>

    <!-- Address bar -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-12 sm:mb-16">
      <span class="text-sm font-mono text-muted">{t('location.address')}</span>
      <span class="text-muted" style="opacity: 0.3;">|</span>
      <span class="text-sm font-mono text-muted">{t('location.transit')}</span>
    </div>

    <!-- Main grid: stats + photo + map -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-0">

      <!-- LEFT COLUMN — Stats + info stack -->
      <div class="flex flex-col">

        <!-- Stats row — oversized numbers -->
        <div class="grid grid-cols-3 gap-0">
          {stats.map((stat) => (
            <div class="border-2 p-4 sm:p-5 -ml-[2px] first:ml-0 group location-stat-cell"
              style="border-color: color-mix(in srgb, var(--fg) 15%, transparent); background: var(--bg-raised);"
            >
              <span class="block font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-none text-accent">
                {stat.value}
              </span>
              <span class="block mt-2 text-[10px] font-mono uppercase tracking-[0.25em] text-muted">
                {stat.label}
              </span>
            </div>
          ))}
        </div>

        <!-- Venue note — with left accent bar -->
        <div class="border-2 border-t-0 p-6 sm:p-8 flex-1" style="border-color: color-mix(in srgb, var(--fg) 15%, transparent); background: var(--bg-raised);">
          <div class="relative pl-5" style="border-left: 3px solid var(--accent);">
            <p class="text-sm leading-relaxed text-muted mb-6">
              {t('location.venue_note')}
            </p>
            <p class="text-xs leading-relaxed text-muted" style="opacity: 0.6;">
              {t('location.history')}
            </p>
          </div>

          <div class="mt-8 pt-6" style="border-top: 1px solid color-mix(in srgb, var(--fg) 8%, transparent);">
            <a
              href="https://www.stadtkloster-frieden.ch/#grosser-saal"
              target="_blank"
              rel="noopener noreferrer"
              class="group/link inline-flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-accent transition-all"
            >
              <span class="relative">
                {t('location.link')}
                <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--accent)] transition-all duration-300 group-hover/link:w-full"></span>
              </span>
              <span class="transition-transform group-hover/link:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN — Photo + Map stacked -->
      <div class="flex flex-col">
        <!-- Photo with overlay data strip -->
        <div class="relative border-2 lg:border-l-0 overflow-hidden" style="border-color: color-mix(in srgb, var(--fg) 15%, transparent);">
          <div class="aspect-[16/10] sm:aspect-[16/9]">
            <img
              src="/images/location/stadtkloster-interior.jpg"
              alt="Stadtkloster Frieden — Grosser Saal"
              class="w-full h-full object-cover location-photo"
              loading="lazy"
            />
            <!-- Gradient overlay from bottom -->
            <div class="absolute inset-0 pointer-events-none"
              style="background: linear-gradient(0deg, var(--bg-raised) 0%, transparent 40%, transparent 80%, color-mix(in srgb, var(--bg) 30%, transparent) 100%);"
            ></div>
          </div>

          <!-- Data strip overlaying photo bottom -->
          <div class="absolute bottom-0 left-0 right-0 px-4 py-3 flex items-center justify-between">
            <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-accent" style="text-shadow: 0 1px 4px rgba(0,0,0,0.8);">
              {lang === 'de' ? 'Grosser Saal' : 'Great Hall'}
            </span>
            <span class="text-[10px] font-mono text-muted" style="opacity: 0.5; text-shadow: 0 1px 4px rgba(0,0,0,0.8);">
              IMG_01
            </span>
          </div>
        </div>

        <!-- Map — raw, full-bleed within cell -->
        <div class="relative border-2 border-t-0 lg:border-l-0 overflow-hidden" style="border-color: color-mix(in srgb, var(--fg) 15%, transparent);">
          <div class="relative min-h-[220px] sm:min-h-[260px]">
            <iframe
              title="Stadtkloster Frieden, Bern"
              class="w-full h-full min-h-[220px] sm:min-h-[260px]"
              style="border:0; filter: saturate(0.2) contrast(1.3) brightness(0.6) invert(1) hue-rotate(180deg);"
              loading="lazy"
              src="https://www.openstreetmap.org/export/embed.html?bbox=7.4280%2C46.9410%2C7.4380%2C46.9460&layer=mapnik&marker=46.9436%2C7.4330"
            ></iframe>
            <!-- Crosshair overlay on map -->
            <div class="absolute inset-0 pointer-events-none flex items-center justify-center" aria-hidden="true">
              <div class="relative">
                <div class="w-[1px] h-8 absolute -top-4 left-1/2" style="background: var(--accent); opacity: 0.4;"></div>
                <div class="w-[1px] h-8 absolute top-0 left-1/2" style="background: var(--accent); opacity: 0.4; transform: translateY(8px);"></div>
                <div class="h-[1px] w-8 absolute top-1/2 -left-4" style="background: var(--accent); opacity: 0.4;"></div>
                <div class="h-[1px] w-8 absolute top-1/2 left-2" style="background: var(--accent); opacity: 0.4;"></div>
              </div>
            </div>
            <!-- Corner data labels -->
            <div class="absolute top-3 left-4 text-[9px] font-mono uppercase tracking-widest text-accent" style="opacity: 0.5;">
              MAP_EMBED
            </div>
            <div class="absolute bottom-3 right-4 text-[9px] font-mono text-muted" style="opacity: 0.4;">
              OpenStreetMap
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Photo subtle zoom on section hover */
  .location-photo {
    transition: transform 4s cubic-bezier(0.25, 0, 0.15, 1);
  }
  #location:hover .location-photo {
    transform: scale(1.03);
  }

  /* Stat cells — accent border flash on hover */
  .location-stat-cell {
    transition: all 0.15s ease;
  }
  .location-stat-cell:hover {
    border-color: var(--accent) !important;
    background: color-mix(in srgb, var(--accent) 4%, var(--bg-raised)) !important;
  }
</style>
